{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    // T-046: the lane spec imports scripts/boot-port.mjs, which is plain JS
    // with JSDoc types (the scripts run under bare `node`, so they cannot
    // be TS). allowJs lets tsc infer from those annotations instead of
    // failing TS7016.
    //
    // T-061 (absorbing T-046-s2): checkJs is now ON, so tsc CHECKS the
    // scripts against their own JSDoc instead of merely READING it to type
    // the spec's imports. Until then a wrong `@param` silently mistyped the
    // spec's expectations, and the annotations on a merge gate's kill path
    // were load-bearing and unverified.
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "playwright.config.ts",
    "preflight.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    // A GLOB, not a list, and that is the point: T-046-s2 named the two
    // scripts that existed when it was written and this directory now holds
    // six. A hand list is the defect T-058 and T-080 each spent a card on.
    "scripts/**/*.mjs"
  ]
}
