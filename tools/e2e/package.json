{
  "name": "@supertaskr/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "supertaskr real-input E2E lane (T-020): Playwright drives the dev bundle + __supertaskrDocsHarness with trusted input — the rejection class synthetic tests provably cannot catch. Third standalone package (ADR-011 family); imports neither app nor parser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "supertaskr": "bin/supertaskr.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "dist/"
  ],
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:docs": "node scripts/docs-gate.mjs --census",
    "health": "node scripts/health-bands-run.mjs",
    "capabilities": "node scripts/capabilities.mjs && node scripts/interview-skill.mjs",
    "capabilities:check": "node scripts/capabilities.mjs --check && node scripts/interview-skill.mjs --check",
    "skill": "node scripts/interview-skill.mjs",
    "skill:check": "node scripts/interview-skill.mjs --check",
    "prepack": "node scripts/interview-skill.mjs --stage",
    "postpack": "node scripts/interview-skill.mjs --unstage",
    "session:check": "node scripts/checkout-currency.mjs",
    "boot:check": "node scripts/tauri-boot-check.mjs",
    "boot:orphan-drill": "node scripts/orphan-drill.mjs",
    "cli": "node bin/supertaskr.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "yaml": "^2.8.0"
  }
}
